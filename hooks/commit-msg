#!/bin/bash
# Strip Devin attribution trailers while preserving commit text on filter errors.
set -eu
if [ "$#" -ne 1 ]; then
    echo "Usage: commit-msg MESSAGE_FILE" >&2
    exit 2
fi
msg_file="$1"
case "$msg_file" in
    /*) ;;
    *) msg_file="$PWD/$msg_file" ;;
esac
tmp=$(mktemp -- "${msg_file}.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT

if grep -v -i -E \
    -e '^[[:blank:]]*Generated with \[Devin\]' \
    -e '^[[:blank:]]*Co-Authored-By:.*(Devin|devin-ai-integration|devin\.ai)' \
    -- "$msg_file" > "$tmp"; then
    :
else
    status=$?
    [ "$status" -eq 1 ] || exit "$status"
fi
perl -0777 -i -pe 's/\n+$/\n/' "$tmp"
chmod --reference="$msg_file" -- "$tmp"
mv -- "$tmp" "$msg_file"
